# Copy this file to .env.local and fill in the values.
# Use the SAME Supabase project as the Noggin app.
# Supabase dashboard > Project Settings > API

NEXT_PUBLIC_SUPABASE_URL=
# Server-only. Never prefix this with NEXT_PUBLIC_ and never commit it.
SUPABASE_SERVICE_ROLE_KEY=

# Used to hash voter IDs for the poll, so no raw identifiers are stored.
# Any long random string will do.
POLL_SALT=
